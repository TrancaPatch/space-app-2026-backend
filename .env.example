# Puerto del servidor backend
PORT=3000

# Proveedor de datos: 'memory' (desarrollo rápido sin Docker) o 'rethinkdb'
DATA_DRIVER=memory

# Clave de API de Google Gemini (opcional para el asistente médico IA)
GEMINI_API_KEY=

# Configuración de RethinkDB (usada cuando DATA_DRIVER=rethinkdb)
RETHINKDB_HOST=localhost
RETHINKDB_PORT=28015
RETHINKDB_DB=spaceapps
